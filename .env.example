# Только публичная веб-страница Telegram: t.me/s/<username>.
# Не используются вход в аккаунт, api_id/api_hash или bot token.
TG_CHANNEL=halyava_vpnz
TG_LOOKBACK=300
TG_MAX_AGE_HOURS=24
SUB_FETCH_MAX=20

# Дополнительные общедоступные GitHub-фиды (только raw.githubusercontent.com).
# Они регулярно обновляются; все кандидаты дополнительно проверяются нашим Xray/Hysteria
# через полный HTTPS-туннель. Большие фиды равномерно ограничиваются по числу URI.
FREE_FEEDS=https://raw.githubusercontent.com/MatinGhanbari/v2ray-configs/main/subscriptions/v2ray/super-sub.txt,https://raw.githubusercontent.com/barry-far/V2ray-Config/main/All_Configs_base64_Sub.txt
FREE_FEED_NODE_CAP=250

# Лимит выдачи: если меньше 20 узлов проходят проверку, публикуются только они.
LIVENESS_MAX=200
PUBLISH_MAX=20
PING_MAX_MS=800
PING_MARGIN_MS=600

# GitHub Actions использует встроенный GITHUB_TOKEN; PAT в репозитории не хранить.
# Для локального деплоя нужен отдельный новый токен, передаваемый только через окружение.
# GH_REPO=owner/name
# GH_TOKEN=<fresh-token>
