# Фиксированная подписка из ровно этих URI; другие источники отключены в workflow.
MANUAL_NODES_FILE=manual_nodes.txt

# Проверить весь небольшой список при каждом запуске.
LIVENESS_MAX=8
LIVENESS_TIMEOUT=8
HY2_CHECK_TIMEOUT=10
LIVENESS_WORKERS=8
PING_MAX_MS=800
PING_MARGIN_MS=600

# GitHub Actions использует встроенный GITHUB_TOKEN; PAT в репозитории не хранить.
