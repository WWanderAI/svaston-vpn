# ===== Источник: ПУБЛИЧНЫЙ Telegram-канал =====
# @username публичного канала (то, что идёт после t.me/).
# Только публичные каналы читаются без входа. Приватные — нельзя.
TG_CHANNEL=@your_vpn_channel

# Сколько последних сообщений сканировать при первом запуске / вручную.
# При регулярных запусках бот читает только новое (состояние в meta.json).
TG_LOOKBACK=300

# Сколько URL-подписок скачивать за один запуск
SUB_FETCH_MAX=20

# ===== GitHub =====
# Для локального прогона (в Actions значения приходят из secrets).
# Пуш в ДРУГОЙ (data) репо: задай GH_TOKEN (PAT с write) и GH_REPO=owner/name.
# GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxx
# GH_REPO=owner/name
